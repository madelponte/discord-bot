
# ── Required ─────────────────────────────────────────────────
DISCORD_TOKEN=
# ── LLM API connection ──────────────────────────────────────
# URL of your llama.cpp server's OpenAI-compatible endpoint.
# Use the Docker service name if on the same compose network.
API_BASE_URL=

# Model name to send in the request (llama.cpp usually ignores
# this, but some setups route by model name).
MODEL_NAME=

# ── Access control ───────────────────────────────────────────
# Comma-separated Discord server (guild) IDs where the bot
# is allowed to respond. Leave empty to allow ALL servers.
ALLOWED_GUILD_IDS=

# ── LLM behaviour ───────────────────────────────────────────
SYSTEM_PROMPT=
MAX_TOKENS=2000

# How many of the channel's most recent messages to include as context
# (counting the message that pinged the bot). The bot reads back over the
# recent channel history so it can see what's been going on, not just the
# single message it was mentioned in. Set to 1 for one-shot (no context).
MAX_CONTEXT_MESSAGES=6

# Minimum seconds between requests from the same user, to stop one
# person from hammering the bot. Set to 0 to disable.
USER_COOLDOWN_SECONDS=5

