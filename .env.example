
# ── Required ─────────────────────────────────────────────────
DISCORD_TOKEN=
# ── LLM API connection ──────────────────────────────────────
# URL of your llama.cpp server's OpenAI-compatible endpoint.
# Use the Docker service name if on the same compose network.
API_BASE_URL=

# Optional API key. When set, requests include it as a Bearer token
# in the Authorization header. Leave empty for an unauthenticated API.
API_KEY=

# Model name to send in the request (llama.cpp usually ignores
# this, but some setups route by model name).
MODEL_NAME=

# ── Access control ───────────────────────────────────────────
# Comma-separated Discord server (guild) IDs where the bot
# is allowed to respond. Leave empty to allow ALL servers.
# When set, direct messages are accepted only from members of these servers.
ALLOWED_GUILD_IDS=

# ── LLM behaviour ───────────────────────────────────────────
#SYSTEM_PROMPT=

# Longest answer the bot will post, in characters, after any <think>…</think>
# reasoning is removed. Longer answers are cut off with "…". The default fits
# in one Discord message; higher values are split across several messages.
MAX_RESPONSE_CHARS=2000

# Optional cap on generated tokens, sent to the API as max_tokens. It counts
# reasoning tokens as well as the answer, so a low value can leave thinking
# models no room to answer. Leave empty to use the server's own limit.
MAX_TOKENS=

# How many of the channel's most recent messages to include as context
# (counting the message that pinged the bot). The bot reads back over the
# recent channel history so it can see what's been going on, not just the
# single message it was mentioned in. Set to 1 for one-shot (no context).
MAX_CONTEXT_MESSAGES=6

# Minimum seconds between requests from the same user, to stop one
# person from hammering the bot. Set to 0 to disable.
USER_COOLDOWN_SECONDS=5

# Maximum active requests across all channels/servers in this bot process.
# Minimum 1. Each user can have only one active request, even with cooldown off.
# Extra requests get a busy reply instead of being queued.
MAX_CONCURRENT_REQUESTS=1
